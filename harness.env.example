# Copy to harness.env (gitignored) and edit. Every key can also be set as an environment variable.

# Trio checkout the harness builds from (cloned on demand; disposable). Default: <harness>/Trio
TRIO_REPO=~/repos/trio-test-harness/Trio
# Your own Trio clone, used as a git --reference to make that clone fast (and as the origin URL)
TH_TRIO_REFERENCE=~/repos/Trio
# owner/repo Trio is cloned from (blank: TH_TRIO_REFERENCE's origin, else nightscout/Trio)
TH_TRIO_ORIGIN=
# Trio branch to test submodule PRs against when the .gitmodules lookup needs a hint
TH_TRIO_BASE_BRANCH=dev

# The app every command acts on unless --app says otherwise: trio or loop
TH_APP=trio
# Loop (--app loop): the LoopWorkspace checkout, a clone to borrow objects from, and the branch it starts from
LOOP_REPO=~/repos/trio-test-harness/LoopWorkspace
TH_LOOP_REFERENCE=~/repos/LoopWorkspace
TH_LOOP_ORIGIN=                 # blank: TH_LOOP_REFERENCE's origin, else LoopKit/LoopWorkspace
TH_LOOP_BASE_BRANCH=feat/tandem-closed-beta

# How git reaches GitHub (all GitHub URLs, incl. private submodules like TandemKit, are rewritten to this):
#   ssh   — your SSH key, which must be loaded in ssh-agent (ssh-add)            [default]
#   https — authenticates with the gh CLI login (`gh auth login`); no SSH key needed
# One-off: `th --git-protocol https …` / `trio-test-e2e --git-protocol https …`. `th doctor` checks it.
TH_GIT_PROTOCOL=ssh

# Apple Team ID (10 chars) for signed device builds (needed for `th build/install --xcode` and the iphone-usb mode).
# Leave empty for simulator-only or rooted-vnc (fake-signed AppSync) builds, or when the checkout's own override file
# sets the team (Trio's ConfigOverride.xcconfig, Loop's LoopConfigOverride.xcconfig; that one wins).
TH_DEVELOPER_TEAM=

# iPhone for Xcode installs (`th install --xcode`): UDID or device name. Blank = the only paired iPhone on USB.
TH_XCODE_DEVICE=

# Xcode to use; blank = newest /Applications/Xcode*.app. No sudo/xcode-select needed (DEVELOPER_DIR is set per command).
TH_XCODE_APP=

# Simulator: device type + runtime (blank runtime = newest installed iOS runtime)
TH_SIM_DEVICE=iPhone 16
TH_SIM_RUNTIME=

# Watch simulator paired with the simulator (`trio-test-e2e --watch`, `th --target watch`); blank runtime = newest watchOS
TH_WATCH_SIM_DEVICE=Apple Watch Series 11 (46mm)
TH_WATCH_SIM_RUNTIME=

# Physical iPhone (TrollVNC). Blank UDID = the only connected device.
TH_DEVICE_UDID=
TH_VNC_VIA_USB=1          # 1: forward TrollVNC's port over USB with iproxy; 0: connect to TH_VNC_HOST directly
TH_VNC_HOST=localhost
TH_VNC_PORT=5901          # TrollVNC "Port" preference
TH_VNC_PASSWORD=          # TrollVNC "FullPassword" if you set one (first 8 chars matter)

# TrollStore installs: the harness serves the .ipa over HTTP; the phone must reach this host:port
TH_IPA_HTTP_PORT=8765
TH_IPA_HTTP_HOST=         # blank = this Mac's LAN IP

# `./trio-test-harness webui`: bind address and port (--host/--port override). 0.0.0.0 makes it reachable from other
# machines; the ?token= URL is still required, but anyone with it can build, drive the phone and comment as you.
TH_WEBUI_HOST=127.0.0.1
TH_WEBUI_PORT=8787

# After every checkout, tracked files get an mtime derived from their git blob hash, so content that is unchanged
# since the last build is not recompiled (git itself stamps every file it writes with "now"). 0 disables it.
TH_STABLE_MTIMES=1

# Default repo for bare PR numbers (Trio; with --app loop a bare number is a LoopKit/LoopWorkspace PR)
TH_DEFAULT_GH_REPO=nightscout/Trio

#!/bin/bash
# End-to-end Trio test entry point (see harness/pipeline.py). Flags or interactive prompts.
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="$HERE/.venv/bin/python"
[ -x "$PY" ] || { echo "trio-test: virtualenv missing; run $HERE/install.sh" >&2; exit 1; }
export PATH="$HERE/.venv/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"
cd "$HERE" || exit 1
exec "$PY" -m harness.pipeline "$@"

#!/usr/bin/env python3
"""Trigger the "Trio e2e (simulator)" GitHub Actions workflow and follow it from the terminal.

    ./trio-test-ci -s jwoglom/TandemKit#395 --comment
    ./trio-test-ci --app loop -s jwoglom/TandemKit#395      # the same PR in Loop (LoopKit/LoopWorkspace)
    ./trio-test-ci 1234 --model opus
    ./trio-test-ci feat/tandem -s TandemKit@my-branch --instructions "check the bolus sheet"
    ./trio-test-ci upstream:feat/tandem-closed-beta -c nightscout/Trio#1580   # a dev PR on the tandem branch
    ./trio-test-ci --attach 35955500012          # follow a run again after Ctrl-C

Prints the run URL, then follows it with `gh run watch` (live step progress) and prints the job's
log once the run is done (GitHub publishes job logs only after a job completes). Ctrl-C stops following; the run keeps
going on GitHub (cancel it with `gh run cancel <id>`).
Needs the gh CLI, signed in with access to the workflow's repository.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone

REPO = "jwoglom/trio-test-harness"
WORKFLOW = "e2e.yml"
TS = re.compile(r"^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d+Z ")


def gh(*args: str, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(["gh", *args], capture_output=True, text=True, check=check)


def gh_json(*args: str):
    return json.loads(gh(*args).stdout)


def parse_args(argv=None) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="trio-test-ci", description="Run the Trio e2e workflow on the macOS workers and follow it.",
        formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__.split("\n\n", 1)[1])
    p.add_argument("trio", nargs="?", default="",
                   help="PR or branch of the app's repo: PR link, owner/repo#N, a nightscout/Trio (or with --app loop, "
                        "LoopKit/LoopWorkspace) PR number, or branch (blank: dev, or the branch that has the submodule)")
    p.add_argument("--app", choices=["trio", "loop"], help="the app under test (default trio)")
    p.add_argument("-s", "--submodule", action="append", default=[], metavar="REF",
                   help="submodule PR (link or owner/repo#N) or NAME@branch; repeatable")
    p.add_argument("--submodule-cherry-pick", action="append", default=[], metavar="REF",
                   help="cherry-pick onto a submodule, in order: a submodule PR, NAME@sha, NAME@A..B or NAME@branch; repeatable")
    p.add_argument("-c", "--cherry-pick", action="append", default=[], metavar="REF",
                   help="cherry-pick onto the app's repo, in order: its PR (its own commits), commit sha, A..B or branch; repeatable")
    p.add_argument("--configuration", choices=["Debug", "Release"])
    p.add_argument("--walk-onboarding", action="store_true", help="tap through onboarding instead of skipping it")
    p.add_argument("--no-smoke", action="store_true", help="do not configure the simulated CGM + Pump Simulator")
    p.add_argument("--model", metavar="MODEL", help="Claude model for the agent (default sonnet)")
    p.add_argument("--instructions", metavar="TEXT", help="extra focus for the agent")
    p.add_argument("--agent-minutes", type=int, metavar="N", help="agent time limit (default 30)")
    p.add_argument("--comment", action="store_true", help="post the report as a PR comment")
    p.add_argument("--sim-device", metavar="NAME", help='simulator device (default "iPhone 17")')
    p.add_argument("--sim-runtime", metavar="NAME", help='e.g. "iOS 26.3" (default: newest installed)')
    p.add_argument("--xcode", metavar="VERSION", help="Xcode version (default 26.2)")
    p.add_argument("--ref", default="main", help="git ref of the workflow to run (default: main)")
    p.add_argument("--repo", default=REPO, help=f"default: {REPO}")
    p.add_argument("--no-follow", action="store_true", help="trigger, print the URL, and exit")
    p.add_argument("--attach", type=int, metavar="RUN_ID", help="follow an existing run instead of starting one")
    p.add_argument("--interval", type=float, default=3.0, help="seconds between refreshes (default 3)")
    p.add_argument("--compact", action="store_true", help="show only relevant/failed steps while watching")
    return p.parse_args(argv)


def workflow_fields(a: argparse.Namespace) -> dict[str, str]:
    """Only what was given; the workflow's own defaults stay the source of truth."""
    f = {"trio": a.trio}
    if a.app:
        f["app"] = a.app
    if a.submodule:
        f["submodules"] = " ".join(a.submodule)
    if a.cherry_pick:
        f["cherry_pick"] = " ".join(a.cherry_pick)
    if a.submodule_cherry_pick:
        f["submodule_cherry_pick"] = " ".join(a.submodule_cherry_pick)
    if a.configuration:
        f["configuration"] = a.configuration
    if a.walk_onboarding:
        f["skip_onboarding"] = "false"
    if a.no_smoke:
        f["smoke"] = "false"
    if a.model:
        f["claude_model"] = a.model
    if a.instructions:
        f["agent_instructions"] = a.instructions
    if a.agent_minutes is not None:
        f["agent_minutes"] = str(a.agent_minutes)
    if a.comment:
        f["post_comment"] = "true"
    if a.sim_device:
        f["sim_device"] = a.sim_device
    if a.sim_runtime:
        f["sim_runtime"] = a.sim_runtime
    if a.xcode:
        f["xcode"] = a.xcode
    return f


def trigger(a: argparse.Namespace) -> int:
    fields = workflow_fields(a)
    started = datetime.now(timezone.utc)
    args = ["workflow", "run", WORKFLOW, "-R", a.repo, "--ref", a.ref]
    for k, v in fields.items():
        args += ["-f", f"{k}={v}"]
    cp = gh(*args, check=False)
    if cp.returncode != 0:
        sys.exit(f"gh workflow run failed:\n{cp.stderr.strip() or cp.stdout.strip()}")
    m = re.search(r"/actions/runs/(\d+)", cp.stdout + cp.stderr)
    if m:
        return int(m.group(1))
    # Older gh does not print the run URL: find the dispatch we just made.
    me = gh("api", "user", "--jq", ".login").stdout.strip()
    for _ in range(30):
        runs = gh_json("run", "list", "-R", a.repo, "-w", WORKFLOW, "-e", "workflow_dispatch", "-L", "10",
                       "--json", "databaseId,createdAt")
        for r in runs:
            if datetime.fromisoformat(r["createdAt"].replace("Z", "+00:00")) >= started.replace(microsecond=0):
                return int(r["databaseId"])
        time.sleep(2)
    sys.exit(f"triggered, but could not find the run; see https://github.com/{a.repo}/actions (as {me})")


def watch(cmd: list[str], url: str) -> None:
    """Run `gh run watch`, keeping the run URL at the top of its display.

    In a terminal gh draws in the alternate screen and redraws from the top-left on every refresh
    (cursor home + clear to end, "\\x1b[J"), so anything printed before it is hidden. Its output is
    piped through here, with GH_FORCE_TTY so gh still draws for a terminal, and the URL is written
    after each clear.
    """
    if not sys.stdout.isatty():
        subprocess.run(cmd)
        return
    env = {**os.environ, "GH_FORCE_TTY": str(shutil.get_terminal_size().columns)}
    header = f"\x1b[1mRun:\x1b[0m {url}\n\n".encode()
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, env=env)
    out = sys.stdout.buffer
    try:
        for line in iter(p.stdout.readline, b""):
            out.write(line.replace(b"\x1b[J", b"\x1b[J" + header))
            out.flush()
        p.wait()
    except KeyboardInterrupt:
        p.terminate()
        out.write(b"\x1b[?1049l")   # leave gh's alternate screen even if it did not get to
        out.flush()
        raise


def follow(repo: str, run_id: int, url: str, interval: float, compact: bool) -> str:
    """`gh run watch` for live step progress, then the job log (published only once the run is done)."""
    cmd = ["gh", "run", "watch", str(run_id), "-R", repo, "-i", str(max(1, int(interval)))]
    watch(cmd + (["--compact"] if compact else []), url)
    cp = gh("run", "view", str(run_id), "-R", repo, "--log", check=False)
    if cp.returncode == 0:
        print("\n----- log -----")
        # `gh run view --log` lines are "<job>\t<step>\t<timestamp> <text>"; keep the step and text.
        for line in cp.stdout.splitlines():
            parts = line.split("\t", 2)
            print(f"{parts[1]} | {TS.sub('', parts[2].lstrip(chr(0xFEFF)))}" if len(parts) == 3 else line, flush=True)
    else:
        print(f"(log not available yet; later: gh run view {run_id} -R {repo} --log)")
    return gh_json("run", "view", str(run_id), "-R", repo, "--json", "conclusion")["conclusion"] or "unknown"


def main(argv=None) -> int:
    a = parse_args(argv)
    if subprocess.run(["gh", "--version"], capture_output=True).returncode != 0:
        sys.exit("the gh CLI is required (brew install gh; gh auth login)")
    run_id = a.attach or trigger(a)
    url = f"https://github.com/{a.repo}/actions/runs/{run_id}"
    print(f"run: {url}", flush=True)
    if a.no_follow:
        return 0
    try:
        conclusion = follow(a.repo, run_id, url, a.interval, a.compact)
    except KeyboardInterrupt:
        print(f"\nstopped following; the run continues: {url}\n"
              f"(follow again: ./trio-test-ci --attach {run_id}; cancel: gh run cancel {run_id} -R {a.repo})")
        return 130
    print(f"\n{conclusion}: {url}")
    return 0 if conclusion == "success" else 1


if __name__ == "__main__":
    sys.exit(main())
